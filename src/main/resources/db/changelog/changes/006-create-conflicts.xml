<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-conflicts" author="shabir">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="conflicts"/></not>
        </preConditions>

        <createTable tableName="conflicts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_a_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_conflicts_request_a"
                             references="work_requests(id)"/>
            </column>
            <column name="request_b_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_conflicts_request_b"
                             references="work_requests(id)"/>
            </column>
            <column name="resolution_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="admin_remarks" type="TEXT"/>
            <column name="resolved_by" type="BIGINT">
                <constraints foreignKeyName="fk_conflicts_resolved_by"
                             references="users(id)"/>
            </column>
            <column name="detected_at" type="TIMESTAMP"/>
            <column name="resolved_at" type="TIMESTAMP"/>
        </createTable>

        <!-- Same pair can't be saved twice (matches @UniqueConstraint on the entity) -->
        <addUniqueConstraint tableName="conflicts"
                             columnNames="request_a_id, request_b_id"
                             constraintName="uk_conflicts_request_pair"/>

        <rollback>
            <dropTable tableName="conflicts"/>
        </rollback>
    </changeSet>

</databaseChangeLog>