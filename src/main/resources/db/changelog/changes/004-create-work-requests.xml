<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-work-requests" author="shabir">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="work_requests"/></not>
        </preConditions>

        <createTable tableName="work_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="department_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_work_requests_department"
                             references="departments(id)"/>
            </column>
            <column name="submitted_by" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_work_requests_submitted_by"
                             references="users(id)"/>
            </column>
            <column name="road_segment_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_work_requests_road_segment"
                             references="road_segments(id)"/>
            </column>
            <column name="work_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="admin_remarks" type="TEXT"/>
            <column name="reviewed_by" type="BIGINT">
                <constraints foreignKeyName="fk_work_requests_reviewed_by"
                             references="users(id)"/>
            </column>
            <column name="reviewed_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <rollback>
            <dropTable tableName="work_requests"/>
        </rollback>
    </changeSet>

</databaseChangeLog>